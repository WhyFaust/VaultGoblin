{
  "hooks": {
    "SessionStart": [{ "hooks": [{
      "type": "command",
      "command": "python3 -B \"${PLUGIN_ROOT}/skills/codex-shared-knowledge/scripts/plugin_hook.py\" --refresh",
      "commandWindows": "& pythonw.exe -B \"$env:PLUGIN_ROOT/skills/codex-shared-knowledge/scripts/plugin_hook.py\" --refresh; exit $LASTEXITCODE",
      "statusMessage": "VaultGoblin: refresh export runtime",
      "timeout": 10
    }] }],
    "Stop": [{ "hooks": [{
      "type": "command",
      "command": "python3 -B \"${PLUGIN_ROOT}/skills/codex-shared-knowledge/scripts/plugin_hook.py\"",
      "commandWindows": "& pythonw.exe -B \"$env:PLUGIN_ROOT/skills/codex-shared-knowledge/scripts/plugin_hook.py\"; exit $LASTEXITCODE",
      "statusMessage": "VaultGoblin: export shared knowledge",
      "timeout": 10,
      "async": true
    }] }],
    "SessionEnd": [{ "hooks": [{
      "type": "command",
      "command": "python3 -B \"${PLUGIN_ROOT}/skills/codex-shared-knowledge/scripts/plugin_hook.py\"",
      "commandWindows": "& pythonw.exe -B \"$env:PLUGIN_ROOT/skills/codex-shared-knowledge/scripts/plugin_hook.py\"; exit $LASTEXITCODE",
      "statusMessage": "VaultGoblin: export shared knowledge",
      "timeout": 3
    }] }]
  }
}
